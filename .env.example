# 本地端模型 OpenAI 相容 API 設定
# 複製此檔案為 .env 並依實際本地端服務修改

# Ollama 預設: http://localhost:11434/v1
# LM Studio 預設: http://localhost:1234/v1
# vLLM / llama.cpp 預設: http://localhost:8000/v1
LLM_BASE_URL=http://localhost:11434/v1

# 本地端通常不驗證金鑰，但 SDK 需要非空字串
LLM_API_KEY=ollama

# 預設使用的模型名稱（請確認已在本地端下載/載入）
LLM_MODEL=qwen2.5:7b

# 日誌設定（可選）
# 等級：DEBUG / INFO / WARNING / ERROR / CRITICAL
LOG_LEVEL=INFO
# 若需同步寫入日誌檔案，取消下行註解並指定路徑
# LOG_FILE=logs/corn_agent.log
